{
  "compilerOptions": {
    "target": "ES2020",
    "lib": [
      "ES2021",
      "DOM"
    ],
    "module": "CommonJS",
    "moduleResolution": "Node",
    "outDir": ".local-data/paper-runtime",
    "rootDir": ".",
    "esModuleInterop": true,
    "strict": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "baseUrl": ".",
    "paths": {
      "@/*": [
        "./src/*"
      ]
    },
    "allowJs": true
  },
  "include": [
    "scripts/paper-worker.ts",
    "scripts/paper-quote-probe.ts",
    "scripts/paper-strategy-worker.ts",
    "scripts/lib/runtime.cjs",
    "scripts/lib/supervisor.ts"
  ]
}
